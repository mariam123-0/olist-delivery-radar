# ===================================
# Data files — too large / regenerable from Kaggle source
# ===================================
data/*.csv
Data/*.csv
Raw Data/*.csv
raw_data/*.csv

# ===================================
# Model artifacts — generated by running the training notebook
# ===================================
models/*.joblib
models/*.pkl
Model/*.joblib
Model/*.pkl

# ===================================
# Jupyter Notebook checkpoints
# ===================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ===================================
# Python cache / bytecode
# ===================================
__pycache__/
*.py[cod]
*$py.class

# ===================================
# Virtual environments
# ===================================
venv/
env/
.venv/
ENV/

# ===================================
# Environment variables / secrets
# ===================================
.env
*.env

# ===================================
# Streamlit
# ===================================
.streamlit/secrets.toml

# ===================================
# OS-generated junk files
# ===================================
.DS_Store
Thumbs.db
desktop.ini

# ===================================
# Editor / IDE settings
# ===================================
.vscode/
.idea/

# ===================================
# Power BI temp/lock files
# ===================================
*.pbix.lock
~$*.pbix
